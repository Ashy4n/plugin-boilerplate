{
    "name": "{{vendor_slug}}/{{slug}}",
    "description": "{{description}}",
    "homepage": "{{plugin_uri}}",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "authors": [
        {
            "name": "{{author}}",
            "email": "{{email}}",
            "homepage": "{{author_url}}"
        }
    ],
    "require": {
        "php": ">={{min_php}}"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0",
        "phpstan/extension-installer": "^1.3",
        "szepeviktor/phpstan-wordpress": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "{{namespace_escaped}}\\": "src/"
        }
    },
    "scripts": {
        "lint": "phpcs --standard=phpcs.xml src/",
        "format": "phpcbf --standard=phpcs.xml src/",
        "analyse": "phpstan analyse -c phpstan.neon",
        "test": "phpunit"
    }
}
